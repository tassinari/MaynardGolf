// App target settings. Shared settings come from Shared.xcconfig (the project level).
#include "Shared.xcconfig"

// X-17, #124: the only permission the app asks for. Asked on the first tap of Show my location, never
// at launch. The English text is localized in InfoPlist.xcstrings. Photos use PhotosPicker and need
// no permission; there's no camera feature, so there are no camera or photo-library descriptions.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Shows your position on the hole map and the distance to the green.

// X-18: v2 is the first App Store release, version 1.2. The build number here is only for local
// builds; `scripts/build.sh release` passes CURRENT_PROJECT_VERSION for every TestFlight upload (#98).
MARKETING_VERSION = 1.2
CURRENT_PROJECT_VERSION = 1

// Export compliance: the app uses only encryption that's exempt (HTTPS through URLSession and
// CloudKit, both Apple's). Declaring it here answers App Store Connect's encryption question for
// every build, so TestFlight builds don't wait at "Missing Compliance" (#98).
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
// SC-BH-02, 05: the Scorecard alone turns to landscape. The app declares portrait and both landscapes,
// and `OrientationController` (through `AppDelegate`) narrows it to portrait everywhere else at run time.
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// DS-BR-03: native full-bleed launch storyboard using the approved golf-ball/M artwork.
INFOPLIST_KEY_UILaunchScreen_Generation = NO
INFOPLIST_KEY_UILaunchStoryboardName = LaunchScreen
