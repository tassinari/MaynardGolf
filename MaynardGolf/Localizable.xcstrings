    "localRule.maynard.1": {
      "comment": "Maynard Golf Club local rule 1, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USGA Rules govern play unless amended by local rules."
          }
        }
      }
    },
    "localRule.maynard.10": {
      "comment": "Maynard Golf Club local rule 10, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair ball marks on green. Replace divots."
          }
        }
      }
    },
    "localRule.maynard.11": {
      "comment": "Maynard Golf Club local rule 11, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please speed up play."
          }
        }
      }
    },
    "localRule.maynard.12": {
      "comment": "Maynard Golf Club local rule 12, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maynard Golf Course is a soft spike facility."
          }
        }
      }
    },
    "localRule.maynard.2": {
      "comment": "Maynard Golf Club local rule 2, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OUT OF BOUNDS: Parking lot, off club property defined by white stakes."
          }
        }
      }
    },
    "localRule.maynard.3": {
      "comment": "Maynard Golf Club local rule 3, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ball coming to rest in a bark mulch area may be lifted and dropped one club length, no nearer the hole, with no penalty."
          }
        }
      }
    },
    "localRule.maynard.4": {
      "comment": "Maynard Golf Club local rule 4, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All service roads, cart paths, fairway drainage ditches, and protective fences, free lift to nearest point of relief, no nearer the hole."
          }
        }
      }
    },
    "localRule.maynard.5": {
      "comment": "Maynard Golf Club local rule 5, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ball coming to rest in the confines of a rock or rocks through the green may be moved one club length without penalty."
          }
        }
      }
    },
    "localRule.maynard.6": {
      "comment": "Maynard Golf Club local rule 6, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players not holding their places on golf course must allow other groups to play through."
          }
        }
      }
    },
    "localRule.maynard.7": {
      "comment": "Maynard Golf Club local rule 7, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players on 1st tee must alternate with players coming off 9th green."
          }
        }
      }
    },
    "localRule.maynard.8": {
      "comment": "Maynard Golf Club local rule 8, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not climb face of bunkers. Rake bunkers and return rake to inside the bunker."
          }
        }
      }
    },
    "localRule.maynard.9": {
      "comment": "Maynard Golf Club local rule 9, from the scorecard (03-local-rules LR-RC-05). Keyed from MaynardGC.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep all carts off aprons and greens."
          }
        }
      }
    },
