{
  "sourceLanguage": "en",
  "strings": {
    "%@ %lld": {
      "comment": "Round row, VoiceOver: one player's gross score, e.g. 'Mark 77'."
    },
    "%@ yds": {
      "comment": "Tee card: total yardage for the round, e.g. '3,013 yds'."
    },
    "%@, %@, %lld holes, %@ tees.": {
      "comment": "Round row, VoiceOver: date, course, hole count and tee, e.g. 'November 8, Maynard Golf Club, 18 holes, Blue tees.'"
    },
    "%@, %@, last played %@.": {
      "comment": "Player summary card, VoiceOver: name, index and the date of the last round, e.g. 'Mark Tassinari, handicap index 8.4, last played November 8.'"
    },
    "%@, %@, no rounds yet.": {
      "comment": "Player summary card, VoiceOver, for a player with no completed rounds, e.g. 'Mark Tassinari, no handicap index, no rounds yet.'"
    },
    "%lld holes · %@": {
      "comment": "Round row meta: hole count and tee, e.g. '18 holes · Blue'."
    },
    "%lld in progress": {
