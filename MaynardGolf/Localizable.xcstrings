{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "Round complete: the round's date and the course, e.g. 'Sat, Nov 8 · Maynard Golf Club'.\nScorecard: the round's start, e.g. 'Wed, Nov 11 · 9:42 AM'."
    },
    "%@ %lld" : {
      "comment" : "Round row, VoiceOver: one player's gross score, e.g. 'Mark 77'."
    },
    "%@ %lld°" : {
      "comment" : "Round PDF: the weather at tee off, e.g. 'Sunny 62°'. Shown in caps."
    },
    "%@ local rules" : {
      "comment" : "Local rules sheet: its accessibility label, e.g. 'Maynard Golf Club local rules'."
    },
    "%@ tees" : {
      "comment" : "Round complete: the tee played, e.g. 'Blue tees'. Shown in caps."
    },
    "%@ yds" : {
      "comment" : "Tee card: total yardage for the round, e.g. '3,013 yds'."
    },
    "%@, %@" : {
      "comment" : "Score histogram, VoiceOver: one bar, e.g. '74–75, 2 rounds'."
    },
    "%@, %@, %lld holes, %@ tees." : {
      "comment" : "Round row, VoiceOver: date, course, hole count and tee, e.g. 'November 8, Maynard Golf Club, 18 holes, Blue tees.'"
    },
    "%@, %@, last played %@." : {
