{
  "about": "Coverage gate rules for scripts/coverage_gate.py (testing-standards TS-UT-02). Globs are fnmatch patterns relative to the repo root; * also crosses /. Add a group with minimum 100 for each pure-logic folder as it is created. A group that matches no files fails unless it sets allowEmpty.",
  "groups": [
    {
      "name": "v2 app code",
      "target": "MaynardGolf.app",
      "minimum": 90,
      "include": [
        "MaynardGolf/*.swift"
      ],
      "exclude": [
        "MaynardGolf/Preview Content/*",
        "MaynardGolf/MaynardGolfApp.swift"
      ]
    },
    {
      "name": "data layer",
      "target": "MaynardGolf.app",
      "minimum": 90,
      "include": [
        "MaynardGolf/Data/*"
      ]
    },
    {
      "name": "data values and snapshots",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Data/Values/*",
        "MaynardGolf/Data/Snapshots/*",
        "MaynardGolf/Data/Models/RoundEntry.swift",
        "MaynardGolf/Data/Models/Player.swift"
      ],
      "exclude": [
        "MaynardGolf/Data/Values/WeatherKind+WeatherKit.swift"
      ]
    },
    {
      "name": "course, routing and launch logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Course/*",
        "MaynardGolf/App/Router.swift",
        "MaynardGolf/App/LaunchArguments.swift",
        "MaynardGolf/App/Plurals.swift"
      ]
    },
    {
      "name": "round PDF model",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/RoundPDF/RoundPDFModel.swift"
      ]
    },
    {
      "name": "all players logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/AllPlayers/AllPlayersViewModel.swift"
      ]
    },
    {
      "name": "player card logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/PlayerCard/PlayerCardStats.swift",
        "MaynardGolf/PlayerCard/ScoreHistogram.swift",
        "MaynardGolf/PlayerCard/HandicapTrend.swift",
        "MaynardGolf/PlayerCard/PlayerCardViewModel.swift"
      ]
    },
    {
      "name": "shot lines logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/ShotLines/*"
      ]
    },
    {
      "name": "MaynardUI",
      "target": "MaynardUI.framework",
      "minimum": 90,
      "include": [
        "MaynardUI/*.swift"
      ]
    },
    {
      "name": "MaynardUI tokens, type and formatting",
      "target": "MaynardUI.framework",
      "minimum": 100,
      "include": [
        "MaynardUI/Tokens/*",
        "MaynardUI/Typography/*",
        "MaynardUI/Formatting/*"
      ]
    },
    {
      "name": "settings logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Settings/SettingsStore.swift",
        "MaynardGolf/Settings/SettingsViewModel.swift"
      ]
    },
    {
      "name": "local rules logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/LocalRules/LocalRulesViewModel.swift"
      ]
    },
    {
      "name": "scorecard logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Scorecard/ScorecardModel.swift",
        "MaynardGolf/Scorecard/ScorecardViewModel.swift"
      ]
    },
    {
      "name": "handicap calculator",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Handicap/HandicapCalculator.swift"
      ]
    },
    {
      "name": "handicap manager",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Handicap/HandicapManager.swift"
      ]
    },
    {
      "name": "player form logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Players/PlayerFormViewModel.swift",
        "MaynardGolf/Players/PlayerColor+Palette.swift"
      ]
    },
    {
      "name": "player photo logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Players/Photo/PhotoCropModel.swift",
        "MaynardGolf/Players/Photo/PhotoEncoder.swift",
        "MaynardGolf/Players/Photo/PlayerPhotoModel.swift"
      ]
    },
    {
      "name": "home logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/Home/RoundSummaryBuilder.swift",
        "MaynardGolf/Home/PlayerSummaryBuilder.swift",
        "MaynardGolf/Home/HomeViewModel.swift",
        "MaynardGolf/Home/RoundMonthSection.swift"
      ]
    },
    {
      "name": "new round logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/NewRound/NewRoundViewModel.swift",
        "MaynardGolf/Players/AvatarCache.swift"
      ]
    },
    {
      "name": "hole play logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/HolePlay/ScoreEntryModel.swift",
        "MaynardGolf/HolePlay/HolePlayViewModel.swift"
      ]
    },
    {
      "name": "course map logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/CourseMap/*"
      ],
      "exclude": [
        "MaynardGolf/CourseMap/CourseImageryLayer.swift"
      ]
    },
    {
      "name": "round complete logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/RoundComplete/RoundCompleteViewModel.swift"
      ]
    },
    {
      "name": "round detail logic",
      "target": "MaynardGolf.app",
      "minimum": 100,
      "include": [
        "MaynardGolf/RoundDetail/RoundDetailViewModel.swift"
      ]
    }
  ]
}
